# Copy to .env at the repo root. Everything is optional: without an API key every
# script prints the committed cached output, so the workshop runs fully offline.

# ── LLM ─────────────────────────────────────────────────────────────────────────
# Provider: anthropic | openai | google | openai-compatible
LLM_PROVIDER=anthropic
# Model id for that provider. claude-sonnet-5 is the default; claude-opus-5 is the
# stronger and pricier swap.
LLM_MODEL=claude-sonnet-5
# Your own key. For anthropic/openai/google the provider's usual env var
# (ANTHROPIC_API_KEY, OPENAI_API_KEY, GOOGLE_GENERATIVE_AI_API_KEY) also works.
LLM_API_KEY=

# Workshop fallback (organizer-provided, cheap model, capped and rotated after the
# event). Uncomment these four and comment the block above.
# LLM_PROVIDER=openai-compatible
# LLM_BASE_URL=https://gateway.example.com/v1
# LLM_MODEL=fallback-model-id
# LLM_API_KEY=key-handed-out-on-the-day

# Force regeneration even when a cache file exists (also works inline: LIVE=1 pnpm phase2)
# LIVE=1

# ── GitHub (facilitator only, for pnpm phase1:seed) ─────────────────────────────
# Leave GITHUB_TOKEN empty to reuse the gh CLI login (`gh auth token`).
GITHUB_TOKEN=
# owner/name of the repo holding the PR. Defaults to the `origin` remote.
GITHUB_REPO=
